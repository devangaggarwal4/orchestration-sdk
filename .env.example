# Azure app registration (see README). "Application (client) ID".
OUTLOOK_CLIENT_ID=
# "common" works for personal + work accounts; use your tenant id to restrict.
OUTLOOK_TENANT=common

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Context window to request from Ollama. 8192 is a good fit for qwen3:8b on 16GB RAM.
OLLAMA_NUM_CTX=8192
# Set to 1 to let qwen3 "think" before answering (slower, sometimes better).
OLLAMA_THINK=0
